{
  "name": "convoze-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start:e2e": "E2E_MODE=true node --env-file-if-exists=.env src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/**/*.test.js'",
    "pretest": "node scripts/migrate-test-db.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.0",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "supertest": "^7.3.0"
  }
}
