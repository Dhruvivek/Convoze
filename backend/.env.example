# Copy to .env and adjust. Requires PostgreSQL 18+ (native uuidv7()).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convoze_dev
# Used by `npm test`; the test suite truncates it, so never point it at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convoze_test
JWT_SECRET=change-me
PORT=3000
# Twilio Verify sends and checks the OTP codes; required outside e2e mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# E2E mode (`npm run start:e2e` sets E2E_MODE=true): mounts the test-only
# /__e2e__ endpoints and a fake OTP verifier. Refused when NODE_ENV=production.
# E2E_OTP_CODE=548726
