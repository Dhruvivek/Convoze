// Schema per ADR 0004 (docs/adr/0004-postgres-schema-and-orm.md). Only the
// auth tables (#20) and the bare Conversation/Participant tables (#21) exist
// so far; later specs add the rest, and their columns (e.g.
// Participant.lastReadMessageId once Message exists).
//
// Requires PostgreSQL 18+: primary keys default to the native uuidv7().

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  android
  ios
}

enum ConversationType {
  direct
  group
}

enum ParticipantRole {
  admin
  member
}

model User {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber     String    @unique
  phoneVerifiedAt DateTime  @db.Timestamptz(3)
  displayName     String?
  avatarUrl       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  sessions        Session[]
  participants    Participant[]
}

model Session {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  platform         Platform
  refreshTokenHash String
  issuedAt         DateTime  @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)

  @@index([userId])
}

model OtpRequest {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber String
  requestedAt DateTime @db.Timestamptz(3)

  @@index([phoneNumber, requestedAt])
  @@map("otp_requests")
}

model Conversation {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         ConversationType
  // Groups only.
  name         String?
  // Direct only: the two participants' user ids, sorted and joined, so the
  // database refuses a second direct Conversation between them (ADR 0004).
  directKey    String?          @unique
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  participants Participant[]
}

// Any code that creates or deletes a Participant row must also call
// `joinUserToConversation` / `removeUserFromConversation`
// (`src/realtime/server.js`), so an already-connected user's live sockets
// join or leave that Conversation's room without reconnecting (#30).
model Participant {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String          @db.Uuid
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(member)
  joinedAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([conversationId, userId])
  @@index([userId])
}
