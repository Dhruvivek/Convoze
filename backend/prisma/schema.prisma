// Schema per ADR 0004 (docs/adr/0004-postgres-schema-and-orm.md). Only the
// auth tables (#20) exist so far; later specs add the rest.
//
// Requires PostgreSQL 18+: primary keys default to the native uuidv7().

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  android
  ios
}

model User {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber     String    @unique
  phoneVerifiedAt DateTime  @db.Timestamptz(3)
  displayName     String?
  avatarUrl       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  sessions        Session[]
}

model Session {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  platform         Platform
  refreshTokenHash String
  issuedAt         DateTime  @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)

  @@index([userId])
}

model OtpRequest {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber String
  requestedAt DateTime @db.Timestamptz(3)

  @@index([phoneNumber, requestedAt])
  @@map("otp_requests")
}
